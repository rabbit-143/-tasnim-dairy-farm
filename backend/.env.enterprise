# 🔒 ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your production deployment

# ============================================
# 🔐 SECURITY CONFIGURATION (REQUIRED)
# ============================================

# JWT Security (MUST change in production)
JWT_SECRET=your-super-secure-jwt-secret-minimum-256-characters-long-random-string-here
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# 🌐 CORS & DOMAIN CONFIGURATION
# ============================================

# Production domains (comma-separated, no wildcards)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# Development (for local testing only)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================

# Production PostgreSQL (Neon/Heroku/AWS RDS)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Local PostgreSQL (for development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tasnim_dairy
# DB_USER=your_username
# DB_PASSWORD=your_password

# SQLite fallback (development only)
USE_SQLITE=false

# ============================================
# 🚀 SERVER CONFIGURATION
# ============================================

# Server settings
PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# ============================================
# 📁 FILE STORAGE CONFIGURATION
# ============================================

# Cloudinary CDN (recommended for production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local file upload settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp

# ============================================
# 📊 MONITORING & LOGGING
# ============================================

# Log levels: error, warn, info, debug
LOG_LEVEL=info

# External monitoring services
# SENTRY_DSN=your_sentry_dsn
# NEWRELIC_LICENSE_KEY=your_newrelic_key

# ============================================
# 🔧 PERFORMANCE & SCALING
# ============================================

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis cache (for production scaling)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# ============================================
# 🛡️ SECURITY HEADERS & FEATURES
# ============================================

# Content Security Policy additional domains
# CSP_ADDITIONAL_DOMAINS=https://cdn.yourdomain.com

# 2FA Configuration
# TOTP_SERVICE_NAME=Tasnim Dairy Farm
# TOTP_ISSUER=Your Company Name

# ============================================
# 📧 NOTIFICATION CONFIGURATION
# ============================================

# Email service (for alerts and notifications)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=notifications@yourdomain.com
# SMTP_PASS=your_email_password

# SMS service (for 2FA)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# 🔍 EXTERNAL API CONFIGURATION
# ============================================

# Chatbot API
LONGCAT_API_URL=https://api.longcat.chat

# Virus scanning service (optional)
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ============================================
# 🚨 PRODUCTION SECURITY CHECKLIST
# ============================================

# ✅ JWT_SECRET is set to a secure random string (256+ chars)
# ✅ CORS_ORIGIN contains only your production domains
# ✅ DATABASE_URL points to production database
# ✅ NODE_ENV is set to 'production'
# ✅ All passwords and secrets are unique and secure
# ✅ SSL/TLS certificates are configured
# ✅ Database backups are configured
# ✅ Log monitoring is set up
# ✅ Error tracking is configured
# ✅ File upload limits are appropriate
# ✅ Rate limiting is configured for your traffic
# ✅ Security headers are tested
# ✅ Admin credentials are changed from defaults

# ============================================
# 📝 DEPLOYMENT NOTES
# ============================================

# 1. Never commit this file with real secrets to version control
# 2. Use environment-specific configuration management
# 3. Rotate secrets regularly (especially JWT_SECRET)
# 4. Monitor logs for security events
# 5. Set up alerts for failed authentication attempts
# 6. Regularly update dependencies for security patches
# 7. Use HTTPS everywhere in production
# 8. Configure proper backup and disaster recovery
# 9. Test security headers with online tools
# 10. Implement proper monitoring and alerting