# Backend Environment Configuration Template

# Database Configuration
# For development: Leave empty to use SQLite
# For production: Set your PostgreSQL connection string
DATABASE_URL=

# Server Configuration
NODE_ENV=development
PORT=3001

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://localhost:3000,http://localhost:5174

# JWT Configuration
# CRITICAL: Change this in production to a strong, random secret
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long

# Admin Seeding (Only needed during setup - DO NOT commit real values)
# These are used ONLY by the seed script to create the first admin account
# ADMIN_USERNAME=change-me
# ADMIN_PASSWORD=change-me-to-strong-password

# API Keys (Optional - add as needed)
# Never commit actual API keys to version control
# EXAMPLE_API_KEY=your-api-key-here

# Security Note:
# 1. Never commit .env files with real secrets
# 2. Use strong, unique secrets for each environment
# 3. Rotate secrets regularly
# 4. Use environment variable injection in production
# 5. Clear ADMIN_PASSWORD from shell history after seeding