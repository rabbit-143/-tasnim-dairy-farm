# Backend Environment Configuration Example
# Copy this to .env and fill in your values

# ============================================
# Environment
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================
# Database (PostgreSQL / Neon)
# ============================================
# Local Development (SQLite):
# Leave DATABASE_URL empty to use SQLite
DATABASE_URL=

# Production (Neon):
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require
# Get this from: https://console.neon.tech -> Connection strings

# ============================================
# CORS Configuration
# ============================================
# Local Development:
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Production:
# CORS_ORIGIN=https://tasnim-dairy-farm.netlify.app

# ============================================
# File Upload (if using Cloudinary)
# ============================================
# Cloudinary (for production file storage)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Optional: Admin Credentials
# ============================================
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=your_hashed_password
